# Copy to .env and fill in. The real .env never goes in the repo.

DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/inventory
PORT=3000

# Apply db/schema.sql + db/seed.sql (and any db/NNN_*.sql) on startup. Needed on a fresh database.
LUPO_MIGRATE=1

# Serve the built client (cd client && npm run build) from the API, so one process does everything.
# SERVE_CLIENT=1

# Time zone used for "today" on the dashboard.
# TZ=America/Mexico_City

# Number of reverse proxies in front of the API (the login rate limit needs it to tell devices apart).
# LUPO_PROXY=1

# Folder where database dumps are kept; the System screen shows the latest one.
# LUPO_BACKUPS=./backups

# Public hostname used as the Web Push VAPID contact (defaults to mailto:admin@example.com).
# LUPO_DOMAIN=inventory.example.com

# AI invoice reader (DeepSeek). Without the key it answers 503 and everything else works.
# DEEPSEEK_API_KEY=
